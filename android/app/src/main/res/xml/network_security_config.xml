<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only: plain HTTP is refused, and only the phone's built-in certificate
     authorities are trusted (certificates a user installs themselves are ignored). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
